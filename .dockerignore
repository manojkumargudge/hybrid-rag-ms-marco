# Send only the sources copied by Dockerfile. Exclude local runtime files,
# credentials, caches, evaluation output, and downloaded artifacts by default.
**
!Dockerfile
!requirements.lock
!app/
!app/**
app/**/__pycache__/
app/**/*.py[cod]
!scripts/
scripts/*
!scripts/download_models.py
!manifests/
manifests/*
!manifests/v3.json
