GROQ_API_KEY=your_groq_api_key_here
# Comma-separated client keys accepted in the X-API-Key header.
# Demo value for local use only: replace it before exposing the service.
API_KEYS=change-me-demo-key
# Only for local development; logs a warning when true.
AUTH_DISABLED=false
# Host port for docker compose (the container always listens on 8000).
API_PORT=8000
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
APPLICATION_VERSION=1.0.0
GIT_VERSION=unknown
MANIFEST_PATH=artifacts/v3/manifest.json
PASSAGES_PATH=artifacts/v3/passages.parquet
DENSE_INDEX_PATH=artifacts/v3/dense_index.faiss
BM25_INDEX_PATH=artifacts/v3/bm25/bm25_index.pkl
BM25_CORPUS_PATH=artifacts/v3/bm25/tokenized_corpus.pkl
INDEX_VERSION=v3
DATA_VERSION=v3
RETRIEVAL_MODE=dense
RERANK_DEPTH=20
RERANK_TOP_K=5
# Hybrid mode only (RETRIEVAL_MODE=hybrid)
RETRIEVAL_K=20
RRF_K=60
HYBRID_DENSE_WEIGHT=0.5
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60