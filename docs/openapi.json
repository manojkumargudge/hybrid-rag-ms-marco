{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "description": "User question (at most MAX_QUERY_CHARS characters; default 2,000).",
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Answer with passage ID citations, or null on abstention or fallback.",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            },
            "title": "Citations",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Machine-readable reason for withholding the answer.",
            "title": "Error"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          }
        },
        "required": [
          "answer",
          "citations",
          "latency_ms"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "SourceResponse": {
        "properties": {
          "passage_id": {
            "title": "Passage Id",
            "type": "integer"
          },
          "passage_text": {
            "title": "Passage Text",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "passage_id",
          "passage_text",
          "score"
        ],
        "title": "SourceResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Retrieval-augmented generation over an MS MARCO passage subset: dense retrieval (or hybrid dense + BM25 with RRF), cross-encoder reranking, and Groq-hosted LLM generation.",
    "title": "Hybrid RAG over MS MARCO",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/query": {
      "post": {
        "description": "Run the RAG pipeline (retrieve -> rerank -> generate). Requires X-API-Key.\n\nIf LLM generation fails after its retries, the response still returns the\nreranked passages, with answer=null and error set.",
        "operationId": "query_rag_api_v1_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Rag",
        "tags": [
          "RAG"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return service health status.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/metadata": {
      "get": {
        "description": "Return non-sensitive model, artifact, and application versions.",
        "operationId": "metadata_metadata_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Metadata Metadata Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metadata"
      }
    },
    "/ready": {
      "get": {
        "description": "Report whether configured RAG artifacts and generation are available.",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness Check"
      }
    }
  }
}
